# Kopiere diese Datei zu .env und passe Werte an. .env ist gitignored.

# --- Ollama (LLM + Embeddings) ---
# dev-Profil (Ollama läuft nativ auf dem Host, Metal): host.docker.internal.
# WICHTIG: Host-Ollama muss auf 0.0.0.0 lauschen, sonst ist es aus dem Container nicht erreichbar:
#   launchctl setenv OLLAMA_HOST 0.0.0.0:11434   (danach Ollama neu starten)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# full-Profil überschreibt dies via docker-compose.full.yml auf http://ollama:11434

# Chat-Modell (Default). MVP-Start ggf. llama3.2:3b (schneller).
CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M
# Embedding-Modell (FEST — nicht zur Laufzeit wechseln, sonst wird der Index inkonsistent).
EMBED_MODEL=bge-m3

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=book_chunks

# --- Backend ---
BACKEND_PORT=8000
SQLITE_PATH=/data/book_rag.db

# --- Retrieval ---
TOP_K=8
