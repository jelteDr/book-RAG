# Kopiere diese Datei zu .env und passe Werte an. .env ist gitignored.

# --- Ollama (LLM + Embeddings) ---
# dev-Profil (Ollama läuft nativ auf dem Host, Metal): host.docker.internal.
# WICHTIG: Host-Ollama muss auf 0.0.0.0 lauschen, sonst ist es aus dem Container nicht erreichbar:
#   launchctl setenv OLLAMA_HOST 0.0.0.0:11434   (danach Ollama neu starten)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# full-Profil überschreibt dies via docker-compose.full.yml auf http://ollama:11434

# Chat-Modell (Default). MVP-Start ggf. llama3.2:3b (schneller).
CHAT_MODEL=qwen2.5:7b-instruct-q4_k_m
# Embedding-Modell (FEST — nicht zur Laufzeit wechseln, sonst wird der Index inkonsistent).
EMBED_MODEL=bge-m3

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=book_chunks

# --- Backend ---
# Host-Port (Container-intern immer 8000). 8001, weil 8000 evtl. belegt ist.
BACKEND_PORT=8001

# --- PostgreSQL (Metriken, Modell-Metadaten, Gruppen/Bücher) ---
# Host-Port 5433 (5432 evtl. belegt); Container-intern bleibt 5432.
POSTGRES_PORT=5433
# Im Container gesetzt (postgres-Service, :5432); für lokalen Backend-Lauf: localhost:5433.
DATABASE_URL=postgresql+asyncpg://bookrag:bookrag@localhost:5433/bookrag

# --- Retrieval ---
TOP_K=8

# --- Small-to-Big (optional; Exp 7: erste abdeckende Quelle MRR 0.474 -> 0.540) ---
# Beste Treffer werden vor dem Prompt-Bau um Nachbar-Chunks erweitert (kein
# Re-Embedding, ein Qdrant-Lookup je Treffer). Kostet ~+36 % Prompt-Laenge —
# vorher `make ollama-ctx` (sonst schneidet Ollama den Prompt bei 4096 Token ab).
SMALL_TO_BIG_ENABLED=false
# S2B_WINDOW=1
# S2B_TOP_N=3

# --- Contextual Ingestion (optional; Exp 5: +0.182 MRR) ---
# Beim Ingest generiert das Chat-LLM pro Chunk 1-2 Saetze Kontext (Pronomen
# aufgeloest), die nur ins Embedding eingehen. ACHTUNG: ~4-6 s pro Chunk —
# ein Buch-Upload dauert damit Minuten bis Stunden. Bestehende Buecher ohne
# Originaldatei umstellen: `uv run python -m app.ingestion.reembed_cli --group ...`
CONTEXTUAL_INGEST_ENABLED=false

# --- Cross-Encoder-Reranker (optional; braucht `uv sync --group reranker`) ---
# Im Container: zusaetzlich INSTALL_ML_EXTRAS=true setzen und `make up-ml`
# (bzw. `docker compose up -d --build backend`), damit torch & Co. ins Image kommen.
# RAM-Hinweis: Reranker + NLI + Ollama gleichzeitig ist auf 24 GB knapp —
# beide Modelle laden lazy beim ersten Chat-Aufruf.
INSTALL_ML_EXTRAS=false
RERANKER_ENABLED=false
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_CANDIDATES=30

# --- Faithfulness-Check (optional; markiert ungestützte Zitate via NLI; reranker-Gruppe) ---
FAITHFULNESS_CHECK_ENABLED=false
# FAITHFULNESS_THRESHOLD=0.5
