# ${BACKEND_UPSTREAM} wird beim Container-Start via envsubst ersetzt
# (Default backend:8000; für lokalen Host-Backend: host.docker.internal:8000).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Buch-Uploads sind groesser als das nginx-Default (1 MB) -> Limit anheben (sonst 413).
    client_max_body_size 50m;

    # API-Reverse-Proxy: /api/… -> Backend (Prefix wird durch das abschließende / entfernt).
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # SSE-Streaming: kein Puffern, langer Timeout.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        chunked_transfer_encoding on;
    }

    # SPA-Fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
